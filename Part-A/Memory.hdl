// Hack memory map: RAM16K, Screen, Keyboard
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // RAM occupies addresses 0..16383
    Not(in=address[14], out=isRAM);
    And(a=load, b=isRAM, out=loadRAM);
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);

    // Screen occupies addresses 16384..24575
    Not(in=address[13], out=notAddress13);
    And(a=address[14], b=notAddress13, out=isScreen);
    And(a=load, b=isScreen, out=loadScreen);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);

    // Keyboard is read-only at address 24576
    Keyboard(out=keyboardOut);

    // Select Screen or Keyboard when address[14] is 1,
    // then select RAM or that device.
    Mux16(a=screenOut, b=keyboardOut, sel=address[13], out=screenOrKeyboard);
    Mux16(a=ramOut, b=screenOrKeyboard, sel=address[14], out=out);
}
