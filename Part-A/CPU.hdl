// Hack CPU — standard Project 5 implementation
CHIP CPU {
    IN  inM[16],
        instruction[16],
        reset;

    OUT outM[16],
        writeM,
        addressM[15],
        pc[15];

    PARTS:
    // A-instruction or C-instruction destination A
    Not(in=instruction[15], out=isAInstruction);
    And(a=instruction[15], b=instruction[5], out=isCDestA);
    Or(a=isAInstruction, b=isCDestA, out=loadA);

    // Select instruction value for A-instructions, ALU result for C-instructions
    Mux16(a=aluOut, b=instruction, sel=isAInstruction, out=aInput);
    Register(in=aInput, load=loadA, out=aOut, out[0..14]=addressM);

    // D register
    And(a=instruction[15], b=instruction[4], out=loadD);
    Register(in=aluOut, load=loadD, out=dOut);

    // ALU y input is A or M, selected by the a-bit
    Mux16(a=aOut, b=inM, sel=instruction[12], out=aluY);

    ALU(
        x=dOut,
        y=aluY,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=aluOut,
        zr=zr,
        ng=ng
    );

    // Memory write control and output
    And(a=instruction[15], b=instruction[3], out=writeM);
    outM=aluOut;

    // Jump condition: JGT, JEQ, JLT
    Not(in=zr, out=notZr);
    Not(in=ng, out=notNg);
    And(a=notNg, b=notZr, out=isPositive);
    And(a=instruction[0], b=isPositive, out=jumpGT);
    And(a=instruction[1], b=zr, out=jumpEQ);
    And(a=instruction[2], b=ng, out=jumpLT);
    Or(a=jumpGT, b=jumpEQ, out=jumpGTorEQ);
    Or(a=jumpGTorEQ, b=jumpLT, out=jumpCondition);
    And(a=instruction[15], b=jumpCondition, out=loadPC);

    PC(in=aOut, load=loadPC, inc=true, reset=reset, out=pcFull);
    pc=pcFull[0..14];
}
